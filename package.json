{
  "name": "@rakkunn/vicem",
  "version": "1.3.0",
  "description": "Zero-Dependency, Zero-Network AI Agent Context Baton & Diet Suite (CLI + MCP Server + Web Studio)",
  "type": "module",
  "main": "./vicem.mjs",
  "bin": {
    "vicem": "vicem.mjs",
    "vicem-cli": "vicem.mjs",
    "vicem-gui": "vicem-gui.mjs"
  },
  "files": [
    "vicem.mjs",
    "vicem-gui.mjs",
    "index.html",
    "logo-dark-transparent.png",
    "logo-light-transparent.png",
    "setup.command",
    "setup.bat",
    ".agents/skills/vicem/SKILL.md",
    "AGENTS.snippet.md",
    "README.md",
    "SECURITY.md",
    "SHA256SUMS",
    "scripts/compat-smoke.mjs",
    "scripts/bench.mjs",
    "docs/COMPATIBILITY.md",
    "docs/BENCHMARK.md"
  ],
  "homepage": "https://rakkunn.github.io/vicem/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rakkunn/vicem.git"
  },
  "author": "Rakkunn",
  "scripts": {
    "build": "node --check ./vicem.mjs && node --check ./vicem-gui.mjs && node --check ./scripts/bench.mjs",
    "start": "node ./vicem.mjs mcp-server",
    "test": "node --test --test-timeout=60000 test/*.test.mjs",
    "bench": "node ./scripts/bench.mjs",
    "doctor": "node ./vicem.mjs doctor",
    "guard": "node ./vicem.mjs guard",
    "stats": "node ./vicem.mjs stats",
    "test:compat": "node scripts/compat-smoke.mjs ."
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "ai-agents",
    "context-compression",
    "handoff",
    "claude-code",
    "codex",
    "antigravity",
    "cursor",
    "mcp",
    "zero-dependency"
  ],
  "license": "MIT"
}
