{
  "name": "vicem",
  "version": "1.1.0",
  "description": "Zero-Dependency, Zero-Network AI Agent Context Baton & Diet Suite (CLI + MCP Server + Web Studio)",
  "type": "module",
  "main": "./vicem.mjs",
  "bin": {
    "vicem": "./vicem.mjs",
    "vicem-gui": "./vicem-gui.mjs"
  },
  "files": [
    "vicem.mjs",
    "vicem-gui.mjs",
    "index.html",
    "logo-dark-transparent.png",
    "logo-light-transparent.png",
    "setup.command",
    "setup.bat",
    ".agents/skills/vicem/SKILL.md",
    "AGENTS.snippet.md",
    "README.md",
    "SECURITY.md",
    "SHA256SUMS"
  ],
  "homepage": "https://rakkunn.github.io/vicem/",
  "repository": {
    "type": "git",
